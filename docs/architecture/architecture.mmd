flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Users([Users, LLM apps]):::edge
        CLI["CLI<br/>scan, attack, train"]:::edge
        Service["HTTP service<br/>/v1/detect /metrics"]:::core
        Validate["Validation<br/>size, types"]:::control
        Users --> CLI ~~~ Service --> Validate
    end

    subgraph State["Data and state"]
        direction TB
        Sources[("13 public sources<br/>1.07M prompts read")]:::data
        Dedup["Dedup, grouping<br/>MinHash LSH"]:::core
        Splits[("Leakage-safe splits<br/>917k prompts")]:::data
        Model[("Bundled model<br/>float16 weights")]:::data
        Sources --> Dedup --> Splits ~~~ Model
    end

    subgraph Core["Detection core (Rust, PyTorch)"]
        direction TB
        Normalize["Normalizer<br/>homoglyph, base64"]:::control
        Features["Hashed n-grams<br/>2^20 buckets"]:::core
        Trainer["FTRL-Proximal<br/>trainer"]:::core
        Scorer["Linear scorer<br/>TF-IDF, logistic"]:::core
        Transformer["Transformer<br/>MiniLM, optional"]:::core
        Normalize --> Features --> Trainer -->|weights| Scorer ~~~ Transformer
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Verdict["Score, verdict<br/>top n-grams"]:::obs
        Bench["Benchmarks, AUROC<br/>vs protectai, Qwen3Guard"]:::obs
        Robust["OOD, robustness<br/>held-out sources"]:::obs
        Metrics["Metrics<br/>Prometheus text"]:::obs
        Verdict --> Bench --> Robust
        Bench ~~~ Metrics
    end

    Interfaces -->|prompts| Core
    State -.->|splits, weights| Core
    Core -->|scores| Obs
